// Windows resource file — version info shown in file properties
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION    1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
FILEFLAGS      0x0L
FILEOS         VOS__WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "HelloQt6"
            VALUE "FileDescription",  "Hello Qt6 Application"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "HelloQt6"
            VALUE "OriginalFilename", "HelloQt6.exe"
            VALUE "ProductName",      "Hello Qt6"
            VALUE "ProductVersion",   "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
